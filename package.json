{
	"name": "tiendanube-snippets",
	"displayName": "Snippets for Tiendanube",
	"description": "Snippets de Twig y validación del {% schema %} para temas de Tiendanube y Nuvemshop, escritos a partir de la documentación oficial.",
	"version": "0.1.0",
	"publisher": "commenteme",
	"icon": "images/icon.png",
	"galleryBanner": {
		"color": "#005278",
		"theme": "dark"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/commentemeapp/tiendanube-snippets.git"
	},
	"homepage": "https://github.com/commentemeapp/tiendanube-snippets#readme",
	"bugs": {
		"url": "https://github.com/commentemeapp/tiendanube-snippets/issues"
	},
	"engines": {
		"vscode": "^1.60.0"
	},
	"categories": [
		"Snippets",
		"Linters",
		"Programming Languages"
	],
	"keywords": [
		"tiendanube",
		"nuvemshop",
		"twig",
		"tpl",
		"theme",
		"ipanema",
		"snippets",
		"schema",
		"sections",
		"blocks"
	],
	"main": "./extension.js",
	"activationEvents": [
		"onLanguage:twig"
	],
	"contributes": {
		"languages": [
			{
				"id": "twig",
				"aliases": [
					"Twig",
					"twig"
				],
				"extensions": [
					".tpl"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"snippets": [
			{
				"language": "twig",
				"path": "./snippets/twig.code-snippets"
			},
			{
				"language": "twig",
				"path": "./snippets/tiendanube.code-snippets"
			},
			{
				"language": "twig",
				"path": "./snippets/settings.code-snippets"
			},
			{
				"language": "json",
				"path": "./snippets/settings.code-snippets"
			},
			{
				"language": "json",
				"path": "./snippets/tiendanube.code-snippets"
			}
		],
		"jsonValidation": [
			{
				"fileMatch": "**/templates/pages/**/*.json",
				"url": "./schemas/template.json"
			},
			{
				"fileMatch": "**/templates/layout/*.json",
				"url": "./schemas/template.json"
			}
		],
		"configuration": {
			"title": "Snippets for Tiendanube",
			"properties": {
				"tiendanubeSnippets.validarSchema": {
					"type": "boolean",
					"default": true,
					"description": "Valida el {% schema %} de sections/*.tpl y blocks/*.tpl de los temas seccionables."
				}
			}
		}
	},
	"scripts": {
		"test": "node --test",
		"gerar": "node scripts/gerar.js",
		"check": "node scripts/gerar.js && git diff --exit-code -- snippets/ && node --test",
		"empacotar": "npx --yes @vscode/vsce package",
		"icone": "node scripts/gerar-icone.js"
	},
	"dependencies": {
		"ajv": "^8.20.0",
		"jsonc-parser": "^3.3.1"
	},
	"devDependencies": {
		"sharp": "^0.35.5"
	}
}
