	"tags": [
		{
			"nome": "set",
			"prefixo": "set",
			"corpo": [
				"{% set ${1:nombre} = ${2:valor} %}"
			],
			"descricao": "Guarda un valor en una variable.",
			"fonte": "twig",
			"tema": "ambos"
		},
		{
			"nome": "if",
			"prefixo": "if",
			"corpo": [
				"{% if ${1:condición} %}",
				"\t$0",
				"{% endif %}"
			],
			"descricao": "Condicional.",
			"fonte": "twig",
			"tema": "ambos"
		},
		{
			"nome": "if else",
			"prefixo": "ifelse",
			"corpo": [
				"{% if ${1:condición} %}",
				"\t$2",
				"{% else %}",
				"\t$0",
				"{% endif %}"
			],
			"descricao": "Condicional con else.",
			"fonte": "twig",
			"tema": "ambos"
		},
		{
			"nome": "for",
			"prefixo": "for",
			"corpo": [
				"{% for ${1:item} in ${2:colección} %}",
				"\t$0",
				"{% endfor %}"
			],
			"descricao": "Recorre una colección; dentro, loop.index, loop.first y loop.last.",
			"fonte": "twig",
			"tema": "ambos"
		},
		{
			"nome": "comentario",
			"prefixo": "comment",
			"corpo": [
				"{# $0 #}"
			],
			"descricao": "Comentario de Twig, que no llega al HTML.",
			"fonte": "twig",
			"tema": "ambos"
		},
		{
			"nome": "snippet",
			"prefixo": "snippet",
			"corpo": [
				"{% snippet \"${1:carpeta/archivo}.tpl\" %}"
			],
			"descricao": "Incluye un snippet sin parámetros; la ruta es relativa a snippets/.",
			"fonte": "twig",
			"tema": "sectionable"
		},
		{
			"nome": "snipplet",
			"prefixo": "snipplet",
			"corpo": [
				"{% snipplet \"${1:archivo}.tpl\" %}"
