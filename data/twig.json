			],
			"descricao": "Renderiza el template JSON de la página en layouts/layout.tpl.",
			"fonte": "layouts",
			"tema": "sectionable"
		},
		{
			"nome": "platform_head_content",
			"prefixo": "platform_head_content",
			"corpo": [
				"{% platform_head_content %}"
			],
			"descricao": "Lo que la plataforma inyecta en el <head>. Va antes de cerrar </head>.",
			"fonte": "layouts",
			"tema": "sectionable"
		},
		{
			"nome": "platform_body_content",
			"prefixo": "platform_body_content",
			"corpo": [
				"{% platform_body_content %}"
			],
			"descricao": "Lo que la plataforma inyecta en el <body>. Va antes de cerrar </body>.",
			"fonte": "layouts",
			"tema": "sectionable"
		},
		{
			"nome": "head_content",
			"prefixo": "head_content",
			"corpo": [
				"{% head_content %}"
			],
			"descricao": "Contenido del <head> que la plataforma arma en los temas clásicos.",
			"fonte": "classicos",
			"tema": "classic"
		},
		{
			"nome": "schema",
			"prefixo": "schema",
			"corpo": [
				"{% schema %}",
				"{",
				"\t$0",
				"}",
				"{% endschema %}"
			],
			"descricao": "Bloque {% schema %} vacío, al final de una section o un bloque.",
			"fonte": "sections",
			"tema": "sectionable"
		}
	]
