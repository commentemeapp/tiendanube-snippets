			"descricao": "Incluye un snipplet de un tema clásico (carpeta snipplets/, con L).",
			"fonte": "twig",
			"tema": "classic"
		},
		{
			"nome": "include",
			"prefixo": "include",
			"corpo": [
				"{% include \"snippets/${1:archivo}.tpl\" with {${2:clave}: ${3:valor}} %}"
			],
			"descricao": "Incluye un snippet pasando variables con with; la ruta empieza en snippets/.",
			"fonte": "twig",
			"tema": "ambos"
		},
		{
			"nome": "embed",
			"prefixo": "embed",
			"corpo": [
				"{% embed \"snippets/${1:archivo}.tpl\" with {${2:clave}: ${3:valor}} %}",
				"\t{% block ${4:nombre} %}",
				"\t\t$0",
				"\t{% endblock ${4:nombre} %}",
				"{% endembed %}"
			],
			"descricao": "Como include, pero rellena los block que el snippet declara.",
			"fonte": "twig",
			"tema": "ambos"
		},
		{
			"nome": "block",
			"prefixo": "block",
			"corpo": [
				"{% block ${1:nombre} %}",
				"\t$0",
				"{% endblock ${1:nombre} %}"
			],
			"descricao": "Declara o rellena un espacio de un snippet usado con embed.",
			"fonte": "twig",
			"tema": "ambos"
		},
		{
			"nome": "paginate",
			"prefixo": "paginate",
			"corpo": [
				"{% paginate by ${1:12} %}"
			],
			"descricao": "Cantidad de productos por página en el listado.",
			"fonte": "listado_classico",
			"tema": "classic"
		},
		{
			"nome": "layout_template",
