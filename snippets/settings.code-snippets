{
	"setting text": {
		"prefix": "setting-text",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"text\",",
			"\t\"id\": \"${1:title}\",",
			"\t\"label\": \"${2:t:settings.title}\",",
			"\t\"default\": \"${3:}\"",
			"}"
		],
		"description": "Texto de una línea.\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	},
	"setting richtext": {
		"prefix": "setting-richtext",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"richtext\",",
			"\t\"id\": \"${1:text}\",",
			"\t\"label\": \"${2:t:settings.text}\",",
			"\t\"default\": \"${3:}\"",
			"}"
		],
		"description": "Texto con formato.\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	},
	"setting number": {
		"prefix": "setting-number",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"number\",",
			"\t\"id\": \"${1:quantity}\",",
			"\t\"label\": \"${2:t:settings.quantity}\",",
			"\t\"default\": 4",
			"}"
		],
		"description": "Número sin límites; si hay mínimo y máximo, mejor range.\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	},
	"setting range": {
		"prefix": "setting-range",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"range\",",
			"\t\"id\": \"${1:vertical_padding}\",",
			"\t\"label\": \"${2:t:settings.vertical_padding}\",",
			"\t\"min\": 0,",
			"\t\"max\": 80,",
			"\t\"step\": 4,",
			"\t\"unit\": \"${3:px}\",",
			"\t\"default\": 32",
			"}"
		],
		"description": "Control deslizante con min, max, step y unit.\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	},
	"setting toggle": {
		"prefix": "setting-toggle",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"toggle\",",
			"\t\"id\": \"${1:show_title}\",",
			"\t\"label\": \"${2:t:settings.show_title}\",",
			"\t\"default\": true",
			"}"
		],
		"description": "Interruptor de sí o no.\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	},
	"setting checkbox": {
		"prefix": "setting-checkbox",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"checkbox\",",
			"\t\"id\": \"${1:show_border}\",",
			"\t\"label\": \"${2:t:settings.show_border}\",",
			"\t\"default\": false",
			"}"
		],
		"description": "Casilla de sí o no (heredada; en settings nuevos, toggle).\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	},
	"setting select": {
		"prefix": "setting-select",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"select\",",
			"\t\"id\": \"${1:size}\",",
			"\t\"label\": \"${2:t:settings.size}\",",
			"\t\"options\": [{\"value\":\"h2\",\"label\":\"t:options.heading_2\"},{\"value\":\"h3\",\"label\":\"t:options.heading_3\"},{\"value\":\"h4\",\"label\":\"t:options.heading_4\"}],",
			"\t\"default\": \"${3:h3}\"",
			"}"
		],
		"description": "Lista desplegable, para muchas opciones.\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	},
	"setting radio": {
		"prefix": "setting-radio",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"radio\",",
			"\t\"id\": \"${1:width}\",",
			"\t\"label\": \"${2:t:settings.section_width}\",",
			"\t\"options\": [{\"value\":\"fit\",\"label\":\"t:options.fit\"},{\"value\":\"fill\",\"label\":\"t:options.fill\"}],",
			"\t\"default\": \"${3:fill}\"",
			"}"
		],
		"description": "Selección visual, para 2 a 4 opciones.\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	},
	"setting text_alignment": {
		"prefix": "setting-text-alignment",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"text_alignment\",",
			"\t\"id\": \"${1:text_alignment}\",",
			"\t\"label\": \"${2:t:settings.text_alignment}\",",
			"\t\"default\": \"${3:center}\"",
			"}"
		],
		"description": "Alineación del texto: izquierda, centro o derecha.\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	},
	"setting alignment": {
		"prefix": "setting-alignment",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"alignment\",",
			"\t\"id\": \"${1:alignment}\",",
			"\t\"label\": \"${2:t:settings.alignment}\",",
			"\t\"options\": [{\"value\":\"start\",\"label\":\"t:options.left\"},{\"value\":\"center\",\"label\":\"t:options.center\"},{\"value\":\"end\",\"label\":\"t:options.right\"}],",
			"\t\"default\": \"${3:center}\",",
			"\t\"vertical_options\": [{\"value\":\"top\",\"label\":\"t:options.top\"},{\"value\":\"center\",\"label\":\"t:options.center\"},{\"value\":\"bottom\",\"label\":\"t:options.bottom\"}],",
			"\t\"vertical_default\": \"${4:center}\"",
			"}"
		],
		"description": "Alineación en dos ejes; en el .tpl, el vertical se lee como <id>_vertical.\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	},
	"setting color": {
		"prefix": "setting-color",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"color\",",
			"\t\"id\": \"${1:background_color}\",",
			"\t\"label\": \"${2:t:settings.background}\",",
			"\t\"default_setting\": \"${3:background_color}\"",
			"}"
		],
		"description": "Selector de color; con default_setting hereda un color global.\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	},
	"setting image_picker": {
		"prefix": "setting-image-picker",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"image_picker\",",
			"\t\"id\": \"${1:image}\",",
			"\t\"label\": \"${2:t:settings.image}\"",
			"}"
		],
		"description": "Imagen subida; en el .tpl, resolve_media o settings_image_url.\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	},
	"setting url": {
		"prefix": "setting-url",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"url\",",
			"\t\"id\": \"${1:link}\",",
			"\t\"label\": \"${2:t:settings.link}\"",
			"}"
		],
		"description": "Selector de enlace.\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	},
	"setting video_url": {
		"prefix": "setting-video-url",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"video_url\",",
			"\t\"id\": \"${1:video_url}\",",
			"\t\"label\": \"${2:t:settings.video_url}\"",
			"}"
		],
		"description": "URL de YouTube o Vimeo; en el .tpl tiene id, type y thumbnail.\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	},
	"setting font_picker": {
		"prefix": "setting-font-picker",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"font_picker\",",
			"\t\"id\": \"${1:font}\",",
			"\t\"label\": \"${2:t:settings.font}\"",
			"}"
		],
		"description": "Familia de fuente, de la lista de Google Fonts del tema.\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	},
	"setting html": {
		"prefix": "setting-html",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"html\",",
			"\t\"id\": \"${1:html}\",",
			"\t\"label\": \"${2:t:settings.html}\",",
			"\t\"default\": \"${3:}\"",
			"}"
		],
		"description": "Editor de HTML.\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	},
	"setting custom_css": {
		"prefix": "setting-custom-css",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"custom_css\",",
			"\t\"id\": \"${1:custom_css}\",",
			"\t\"label\": \"${2:t:settings.custom_css}\",",
			"\t\"default\": \"${3:}\"",
			"}"
		],
		"description": "Editor de CSS, como el CSS propio global del tema.\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	},
	"setting custom_code": {
		"prefix": "setting-custom-code",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"custom_code\",",
			"\t\"id\": \"${1:code}\",",
			"\t\"label\": \"${2:t:settings.code}\",",
			"\t\"default\": \"${3:}\"",
			"}"
		],
		"description": "Editor de HTML, CSS y JS, como el del bloque code (hasta 50.000 caracteres).\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	},
	"setting button_preview": {
		"prefix": "setting-button-preview",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"button_preview\",",
			"\t\"id\": \"${1:button_preview}\"",
			"}"
		],
		"description": "Vista previa, no editable, del botón configurado en el mismo panel.\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	},
	"setting label_preview": {
		"prefix": "setting-label-preview",
		"body": [
			"{",
			"\t\"type\": \"setting\",",
			"\t\"setting_type\": \"label_preview\",",
			"\t\"id\": \"${1:label_preview}\"",
			"}"
		],
		"description": "Vista previa, no editable, de la etiqueta configurada en el mismo panel.\nhttps://nuvemshop.dev/en-US/themes/sectionable-themes/schema-reference"
	}
}
